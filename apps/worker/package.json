{
  "name": "@district/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Temporal worker and workflows for DistrictWorkflow",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "server": "mkdir -p .data && .bin/temporal server start-dev --ip 127.0.0.1 --db-filename .data/temporal.db",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/worker.ts",
    "start": "node dist/worker.js",
    "workflow": "tsx src/client.ts",
    "setup:cli": "sh scripts/install-cli.sh",
    "training-fund:consume": "tsx src/intake/training-fund.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.ts",
    "training-fund:resend": "tsx src/commands/resend-training-fund.ts",
    "test:registration-web": "node --import tsx --test tests/*.web.ts",
    "email:preview": "node --import tsx scripts/preview-emails.ts",
    "members:schedule": "tsx src/commands/schedule-member-sync.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@district/application": "workspace:*",
    "@district/contracts": "workspace:*",
    "@district/domain": "workspace:*",
    "@district/integrations": "workspace:*",
    "@district/persistence": "workspace:*",
    "@temporalio/client": "~1.24.0",
    "@temporalio/common": "~1.24.0",
    "@temporalio/worker": "~1.24.0",
    "@temporalio/workflow": "~1.24.0",
    "dotenv": "~18.0.5"
  },
  "devDependencies": {
    "@temporalio/testing": "~1.24.0",
    "@types/node": "~24.19.1",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "@swc/core": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "protobufjs": {
      "built": true
    }
  }
}
