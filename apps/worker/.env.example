# Application PostgreSQL database (server-side only).
DATABASE_URL=postgresql://district:local-development-only@127.0.0.1:5433/district_workflow

# Required for database integration tests; role must have CREATEDB.
# TEST_DATABASE_URL=postgresql://district:local-development-only@127.0.0.1:5433/postgres

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=district-workflow
# For Temporal Cloud, set its namespace/address and enable TLS:
# TEMPORAL_TLS=true
# TEMPORAL_API_KEY=

# District Training Fund
AWS_REGION=eu-west-2
TRAINING_FUND_QUEUE_URL=
TRAINING_FUND_ROUTING_FILE=./training-fund.routing.json
TRAINING_FUND_FROM_EMAIL=
TRAINING_FUND_PUBLIC_URL=http://localhost:3030
# Shared with Next.js; at least 32 bytes; keep in your secret store.
TRAINING_FUND_SIGNING_KEY=
TRAINING_FUND_LINK_DAYS=30

# Shared themed email activity (takes precedence over TRAINING_FUND_FROM_EMAIL).
NOTIFICATION_FROM_EMAIL=
# Optional address for replies; a single email address, not a display name.
NOTIFICATION_REPLY_TO_EMAIL=

# Full district-team collection endpoint (includes member_contact_methods).
DISTRICT_TEAM_MEMBERS_URL=https://district-team.example.org/api/members
# Optional exact Authorization header, if required by the API gateway.
DISTRICT_TEAM_AUTHORIZATION=
