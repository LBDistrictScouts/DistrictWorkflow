# Application PostgreSQL database (server-side only).
DATABASE_URL=postgresql://district:local-development-only@127.0.0.1:5433/district_workflow

# Next.js connects directly to SQS and Temporal; credentials stay server-side.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
AWS_REGION=eu-west-2
TRAINING_FUND_QUEUE_URL=
# Same signing key as the worker (at least 32 bytes)
TRAINING_FUND_SIGNING_KEY=
# Public browser origin used for CSRF checks; no trailing slash.
PUBLIC_APP_ORIGIN=http://localhost:3030
# Trusted members session validator. The named cookie is forwarded to this URL.
# It must return HTTP 200 with { "authenticated": true } for a valid session.
MEMBERS_SESSION_URL=
MEMBERS_SESSION_COOKIE_NAME=
# Cognito managed login. WORKFLOW_ENV selects the exact required workflow-{env} group.
WORKFLOW_ENV=dev
COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional for an app client with a secret; server-side only.
COGNITO_CLIENT_SECRET=

# Local AWS (Moto): run `corepack yarn aws:local:up` from the repository root.
# The setup command fills the local queue URL, endpoints, test credentials and shared signing key.
# Do not copy the local endpoint/test credentials into a deployed environment.

# Standard simple/complex response tasks: same values in web and worker.
# Signing key: >=32 bytes. Encryption key: exactly 64 hex characters (32 random bytes).
RESPONSE_TASK_SIGNING_KEY=
RESPONSE_ENCRYPTION_KEY=

# Full URL of the existing Activity notifications form on the district members website.
ACTIVITY_NOTIFICATION_FORM_URL=
