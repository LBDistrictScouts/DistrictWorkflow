{
  "name": "@district/persistence",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@district/application": "workspace:*",
    "@district/contracts": "workspace:*",
    "dotenv": "~18.0.5",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "~24.19.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "tsx": "~4.23.15",
    "typescript": "~5.9.3"
  }
}
